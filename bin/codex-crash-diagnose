#!/bin/bash

# Select a Codex model and reasoning effort before diagnosing an Omarchy crash.

set -euo pipefail

usage() {
  echo "Usage: codex-crash-diagnose [--terminal] <pid> [comm] [exe] [signal]" >&2
}

terminal_mode=false
if [[ ${1:-} == --terminal ]]; then
  terminal_mode=true
  shift
fi

pid=${1:-}
[[ $pid =~ ^[0-9]+$ ]] || {
  usage
  exit 1
}

comm=${2:-unknown}
exe=${3:-unknown}
signal=${4:-unknown}

if [[ $terminal_mode == false ]]; then
  self=$(readlink -f "${BASH_SOURCE[0]}")
  exec omarchy-launch-tui --app-id=org.omarchy.agent "$self" --terminal "$pid" "$comm" "$exe" "$signal"
fi

command -v gum >/dev/null || {
  echo "The Codex crash picker requires gum." >&2
  exit 1
}
command -v codex >/dev/null || {
  echo "Codex is not installed." >&2
  exit 1
}

config_file=${CODEX_HOME:-$HOME/.codex}/config.toml
default_model=$(sed -n 's/^model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$config_file" 2>/dev/null | head -n 1)
default_effort=$(sed -n 's/^model_reasoning_effort[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$config_file" 2>/dev/null | head -n 1)

astra_label="GPT-6 Astra — hardest investigations"
sol_label="GPT-5.6 Sol — most capable 5.6"
terra_label="GPT-5.6 Terra — balanced"
luna_label="GPT-5.6 Luna — fastest and lowest cost"
model_options=("$sol_label" "$terra_label" "$luna_label" "$astra_label")

case $default_model in
gpt-6-astra) selected_model=$astra_label ;;
gpt-5.6-terra) selected_model=$terra_label ;;
gpt-5.6-luna) selected_model=$luna_label ;;
*) selected_model=$sol_label ;;
esac

if ! model_choice=$(gum choose --header "Crash diagnosis: choose a Codex model" --selected "$selected_model" "${model_options[@]}"); then
  exit 0
fi

case $model_choice in
"$astra_label")
  model=gpt-6-astra
  effort_options=(low medium high xhigh max)
  ;;
"$sol_label")
  model=gpt-5.6-sol
  effort_options=(none low medium high xhigh max)
  ;;
"$terra_label")
  model=gpt-5.6-terra
  effort_options=(none low medium high xhigh max)
  ;;
"$luna_label")
  model=gpt-5.6-luna
  effort_options=(none low medium high xhigh max)
  ;;
*)
  echo "Unknown model selection: $model_choice" >&2
  exit 1
  ;;
esac

selected_effort=${default_effort:-medium}
if [[ " ${effort_options[*]} " != *" $selected_effort "* ]]; then
  selected_effort=medium
fi

if ! effort=$(gum choose --header "Crash diagnosis: choose reasoning level" --selected "$selected_effort" "${effort_options[@]}"); then
  exit 0
fi

omarchy_path=${OMARCHY_PATH:-/usr/share/omarchy}
skill="$omarchy_path/default/agents/skills/diagnose-crash/SKILL.md"
when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

prompt=$(
  printf '%s\n' \
    "A process crashed on this Omarchy machine and I want to know why." \
    "" \
    "What systemd-coredump recorded:" \
    "  process:  $comm" \
    "  PID:      $pid" \
    "  binary:   $exe" \
    "  signal:   $signal" \
    "  time:     $when" \
    "" \
    "Use the diagnose-crash skill: it covers how to investigate, what to report, and" \
    "when a crash is worth reporting upstream to Omarchy. If your harness has no skill" \
    "mechanism, read the skill files directly and follow them instead:" \
    "" \
    "  $skill"
)

[[ $PWD != "$HOME" || ! -d $HOME/Work ]] || cd "$HOME/Work"
exec codex --approve-for-me --model "$model" -c "model_reasoning_effort=\"$effort\"" -- "$prompt"
